---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {
  formatDate,
  getAllTags,
  getTagEntries,
  getOrderedPosts,
  getPostsByTag,
  getPostPath,
  getTagPath,
  isDevelopmentDraft,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = getOrderedPosts(await getCollection('blog'));
  const tagEntries = getTagEntries(getAllTags(posts));

  return tagEntries.map(({ display, identity }) => ({
    params: { tag: identity },
    props: { tag: display, tagIdentity: identity, posts: getPostsByTag(posts, display) },
  }));
}

const { tag, tagIdentity, posts } = Astro.props;
---

<SiteLayout
  title={`#${tag} // upiscium`}
  description={`記事タグ「${tag}」の一覧。`}
>
  <main class="page" aria-labelledby="tag-title">
    <a class="back-link" href="/blog/tags/">← All tags</a>
    <header class="page-header">
      <p class="eyebrow">/blog/tags/{tagIdentity}</p>
      <h1 id="tag-title">#{tag}</h1>
    </header>

    {posts.length > 0 ? (
      <ol class="posts">
        {posts.map((post) => (
          <li>
            <article class="card">
              <a class="card-link" href={getPostPath(post)}>
                <div class="post-meta">
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                  {isDevelopmentDraft(post) && (
                    <span class="draft-badge">DRAFT · DEVELOPMENT</span>
                  )}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
              <ul class="tags" aria-label={`Tags for ${post.data.title}`}>
                {post.data.tags.map((postTag: string) => (
                  <li><a href={getTagPath(postTag)}>#{postTag}</a></li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">No posts use this tag yet.</p>
    )}
  </main>
</SiteLayout>

<style>
  .page {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .back-link,
  .eyebrow,
  .post-meta,
  .draft-badge {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
  }

  .page-header {
    margin-bottom: 24px;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    line-height: 1.1;
  }

  .eyebrow,
  .post-meta,
  .draft-badge {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lead,
  .card p,
  .empty {
    color: var(--muted);
    line-height: 1.8;
  }

  .posts {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--panel);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover h2,
  .card-link:focus-visible h2 {
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .draft-badge {
    color: var(--accent-2);
  }

  .card h2 {
    margin: 8px 0;
    color: var(--text);
  }

  .card p {
    margin-bottom: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    .post-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
