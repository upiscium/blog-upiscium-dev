---
import { getCollection } from 'astro:content';
import { getEffectiveSlug, getPublishedPosts } from '../../lib/blog';

const posts = getPublishedPosts(await getCollection('blog'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog // SIGNAL</title>
  </head>
  <body>
    <main class="page">
      <p class="eyebrow">/blog</p>
      <h1>Recent Posts</h1>
      <section class="list">
        {posts.map((post) => (
          <a class="card" href={`/blog/${getEffectiveSlug(post)}/`}>
            <div>
              <p class="meta">{post.data.publishedAt.toISOString().slice(0, 10)}</p>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
            <div class="tags">
              {post.data.tags.map((tag: string) => <span>{`#${tag}`}</span>)}
            </div>
          </a>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #050816;
    color: #d7f6ff;
    font-family: system-ui, sans-serif;
    letter-spacing: 0.01em;
    word-spacing: 0.02em;
  }
  .page {
    width: min(900px, calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 64px;
  }
  .eyebrow,
  .meta {
    font-family: ui-monospace, monospace;
    color: #5df3ff;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .8rem;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .card {
    display: grid;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(93, 243, 255, 0.18);
    border-radius: 18px;
    padding: 20px;
    background: linear-gradient(180deg, rgba(10, 18, 36, 0.92), rgba(3, 10, 24, 0.76));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    color: #86a9b6;
    font-family: ui-monospace, monospace;
    letter-spacing: 0.04em;
    line-height: 1.8;
  }

  .card p {
    line-height: 1.85;
  }

  .card h2 {
    line-height: 1.25;
  }

  .eyebrow::after {
    content: '_';
    margin-left: 0.15em;
    animation: blink 1s steps(1, end) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
