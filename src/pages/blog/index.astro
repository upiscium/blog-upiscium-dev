---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  formatDate,
  getOrderedPosts,
  getPostPath,
  getTagPath,
  isDevelopmentDraft,
} from '../../lib/blog';

const posts = getOrderedPosts(await getCollection('blog'));
---

<SiteLayout
  title="Blog // upiscium"
  description="upiscium の設計・実装・運用に関する技術ブログの記事一覧。"
>
  <main class="page" aria-labelledby="blog-title">
    <header class="page-header">
      <p class="eyebrow">/blog</p>
      <h1 id="blog-title">All posts</h1>
      <p class="lead">設計・実装・運用のログ。</p>
    </header>

    {posts.length > 0 ? (
      <ol class="posts">
        {posts.map((post) => (
          <li>
            <article class="card">
              <a class="card-link" href={getPostPath(post)}>
                <div class="post-meta">
                  <span>
                    <span class="meta-label">Published</span>
                    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                  </span>
                  <span>
                    <span class="meta-label">Language</span>
                    {post.data.lang}
                  </span>
                  {post.data.updatedAt && (
                    <span>
                      <span class="meta-label">Updated</span>
                      <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time>
                    </span>
                  )}
                  {isDevelopmentDraft(post) && (
                    <span class="draft-badge">DRAFT · DEVELOPMENT</span>
                  )}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
              {post.data.tags.length > 0 && (
                <ul class="tags" aria-label={`Tags for ${post.data.title}`}>
                  {post.data.tags.map((tag: string) => (
                    <li><a href={getTagPath(tag)}>#{tag}</a></li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">No posts have been published yet.</p>
    )}
  </main>
</SiteLayout>

<style>
  .page {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 24px;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1,
  h2 {
    line-height: 1.1;
  }

  .eyebrow,
  .post-meta,
  .draft-badge {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-meta > span {
    display: inline-flex;
    gap: 6px;
  }

  .meta-label {
    color: var(--muted);
  }

  .lead,
  .card p,
  .empty {
    color: var(--muted);
    line-height: 1.8;
  }

  .posts {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px;
    background: var(--panel);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover h2,
  .card-link:focus-visible h2 {
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .draft-badge {
    color: var(--accent-2);
  }

  .card h2 {
    margin: 8px 0;
    color: var(--text);
  }

  .card p {
    margin-bottom: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    .post-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
