---
import { getCollection, render } from 'astro:content';
import { getEffectiveSlug, getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));

  return posts.map((post) => ({
    params: { slug: getEffectiveSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang={post.data.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title} // SIGNAL</title>
    <meta name="description" content={post.data.description} />
  </head>
  <body>
    <main class="page">
      <a href="/blog/">← Back</a>
      <p class="eyebrow">{post.data.publishedAt.toISOString().slice(0, 10)}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <article class="content">
        <Content />
      </article>
    </main>
  </body>
</html>

<style>
  :global(h1, h2, h3, p) {
    margin-top: 0;
  }

  body {
    margin: 0;
    background: #050816;
    color: #d7f6ff;
    font-family: system-ui, sans-serif;
  }
  .page {
    width: min(760px, calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 64px;
  }
  .eyebrow,
  a {
    font-family: ui-monospace, monospace;
    color: #5df3ff;
  }
  .lead,
  .content {
    color: #86a9b6;
    line-height: 1.8;
  }
  .content :global(pre) {
    overflow: auto;
    padding: 16px;
    border-radius: 16px;
    background: rgba(10, 18, 36, 0.82);
    border: 1px solid rgba(93, 243, 255, 0.18);
  }
  .content :global(code) {
    font-family: ui-monospace, monospace;
  }
  .content :global(:not(pre) > code) {
    padding: 0.15rem 0.35rem;
    border-radius: 6px;
    background: rgba(93, 243, 255, 0.1);
    color: #d7f6ff;
  }
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #d7f6ff;
  }
  .content :global(p),
  .content :global(ul),
  .content :global(ol),
  .content :global(blockquote),
  .content :global(table) {
    margin-bottom: 1rem;
  }
  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.4rem;
  }
  .content :global(li + li) {
    margin-top: 0.35rem;
  }
  .content :global(blockquote) {
    margin-left: 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 3px solid rgba(93, 243, 255, 0.5);
    color: #b6dce6;
  }
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .content :global(th),
  .content :global(td) {
    border: 1px solid rgba(93, 243, 255, 0.18);
    padding: 8px 12px;
  }
  .content :global(th) {
    background: rgba(93, 243, 255, 0.08);
    color: #d7f6ff;
    text-align: left;
  }
  .content :global(a) {
    color: #7cffb2;
    text-decoration-color: rgba(124, 255, 178, 0.6);
  }
  .content :global(hr) {
    border: 0;
    border-top: 1px solid rgba(93, 243, 255, 0.18);
    margin: 1.5rem 0;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: 16px;
  }
</style>
