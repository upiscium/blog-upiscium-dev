---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  formatDate,
  getOrderedPosts,
  getPostPath,
  getTagPath,
  isDevelopmentDraft,
} from '../lib/blog';

const posts = getOrderedPosts(await getCollection('blog'));
---

<SiteLayout
  title="upiscium // blog"
  description="upiscium の設計・実装・運用に関する技術ブログ。"
>
  <main class="page home-page">
    <section class="hero panel" aria-labelledby="home-title">
      <p class="eyebrow">handle: upiscium</p>
      <h1 id="home-title">Technical notes for building useful systems.</h1>
      <p class="lead">
        設計・実装・運用の視点から、日々の開発で得た知見を記録しています。
        新しい記事はこのブログに追加していきます。
      </p>
      <a class="primary-link" href="/blog/">Read the latest posts →</a>
    </section>

    <section class="panel posts-panel" aria-labelledby="latest-posts-title">
      <div class="section-head">
        <div>
          <p class="section-label">/blog</p>
          <h2 id="latest-posts-title">Latest posts</h2>
        </div>
        <a href="/blog/">View all posts →</a>
      </div>

      {posts.length > 0 ? (
        <ol class="posts">
          {posts.map((post) => (
            <li class="post-card">
              <a class="post-card-link" href={getPostPath(post)}>
                <div class="post-meta">
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                  {isDevelopmentDraft(post) && (
                    <span class="draft-badge">DRAFT · DEVELOPMENT</span>
                  )}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
              {post.data.tags.length > 0 && (
                <ul class="tags" aria-label={`Tags for ${post.data.title}`}>
                  {post.data.tags.map((tag: string) => (
                    <li><a href={getTagPath(tag)}>#{tag}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted">No posts have been published yet.</p>
      )}
    </section>

    <section class="panel about-panel" aria-labelledby="about-title">
      <p class="section-label">/about</p>
      <h2 id="about-title">About this log</h2>
      <p>
        読みやすい構造と、記事や機能が育つ土台づくりを大切にしています。
        制作物やプロフィールは、準備ができたものから追加します。
      </p>
    </section>
  </main>
</SiteLayout>

<style>
  .page {
    display: grid;
    gap: 20px;
  }

  .panel {
    border: 1px solid var(--line);
    background: var(--panel);
    backdrop-filter: blur(16px);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 0 0 1px rgba(93, 243, 255, 0.04), 0 24px 80px rgba(0, 0, 0, 0.35);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.1;
  }

  .hero h1 {
    max-width: 14ch;
    margin-top: 8px;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
  }

  .eyebrow,
  .section-label,
  .post-meta,
  .draft-badge {
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lead,
  .about-panel p,
  .muted,
  .post-card p {
    color: var(--muted);
    line-height: 1.8;
  }

  .lead {
    max-width: 60ch;
    font-size: 1.05rem;
  }

  .primary-link {
    display: inline-block;
    margin-top: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .section-head h2 {
    margin-bottom: 0;
  }

  .section-head a {
    white-space: nowrap;
  }

  .posts {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-card {
    border: 1px solid rgba(93, 243, 255, 0.1);
    border-radius: 16px;
    padding: 16px;
    background: rgba(3, 10, 24, 0.5);
  }

  .post-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card-link:hover h3,
  .post-card-link:focus-visible h3 {
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .post-card h3 {
    margin: 8px 0 0;
    color: var(--text);
  }

  .post-card p {
    margin: 8px 0 0;
  }

  .draft-badge {
    color: var(--accent-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }

  .about-panel {
    display: grid;
    gap: 8px;
  }

  .about-panel p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .section-head,
    .post-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
