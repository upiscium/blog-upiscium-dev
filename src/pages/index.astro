---
import { getCollection } from 'astro:content';
import { getEffectiveSlug, getPublishedPosts } from '../lib/blog';

const posts = getPublishedPosts(await getCollection('blog'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const works = [
  {
    name: 'Realtime Dashboard',
    stack: 'Astro, TypeScript, WebSocket',
    role: 'UI / Performance',
  },
  {
    name: 'Developer Notes Hub',
    stack: 'Markdown, RSS, Search',
    role: 'Content / IA',
  },
  {
    name: 'Ops Logbook',
    stack: 'Next.js, API, PostgreSQL',
    role: 'Full Stack',
  },
];

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PORTFOLIO // SIGNAL</title>
    <meta
      name="description"
      content="CLI/サイバー感のある、Blog中心のポートフォリオサイト。"
    />
  </head>
  <body>
    <main class="shell">
      <section class="hero panel">
        <p class="eyebrow">status: online / profile loaded</p>
        <h1>&gt; hi, i'm a developer building sharp interfaces and useful systems.</h1>
        <p class="lead">
          Blogを中心に、設計・実装・運用の視点を発信するポートフォリオ。
          端末のような手触りで、技術の温度感が伝わる構成にしています。
        </p>
        <div class="terminal" data-terminal>
          <div class="terminal-bar">
            <span></span>
            <span></span>
            <span></span>
            <small>session://home</small>
          </div>
          <div class="terminal-lines" data-terminal-log></div>
        </div>
        <div class="stats">
          <div><span>focus</span><strong>blog / systems</strong></div>
          <div><span>stack</span><strong>Astro / TS / UI</strong></div>
          <div><span>mode</span><strong>CLI cyber</strong></div>
        </div>
      </section>

      <section class="grid">
        <article class="panel">
          <p class="section-label">/about</p>
          <h2>Profile</h2>
          <p>
            フロントエンドを軸に、読みやすさと構造を大事にするエンジニア。
            画面の見た目だけでなく、記事や機能が育つ土台づくりを重視します。
          </p>
        </article>

        <article class="panel">
          <p class="section-label">/works</p>
          <h2>Works</h2>
          <ul class="list">
            {works.map((work) => (
              <li>
                <strong>{work.name}</strong>
                <span>{work.stack}</span>
                <small>{work.role}</small>
              </li>
            ))}
          </ul>
        </article>
      </section>

      <section class="panel blog">
        <div class="section-head">
          <div>
            <p class="section-label">/blog</p>
            <h2>Recent Posts</h2>
          </div>
          <p class="muted">latest logs / engineering notes</p>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <a class="post-card" href={`/blog/${getEffectiveSlug(post)}/`}>
              <div class="post-meta">
                <span>{post.data.publishedAt.toISOString().slice(0, 10)}</span>
                {post.data.tags[0] && <span>#{post.data.tags[0]}</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="panel footer-panel">
        <p class="section-label">/contact</p>
        <h2>Signal</h2>
        <p>
          GitHub / X / Mail を並べて、記事更新や制作物に自然につなげる想定です。
        </p>
      </section>
    </main>
  <script is:inline>
    const lines = [
      ['whoami', 'developer focused on blog-driven portfolios'],
      ['pwd', '/home/profile'],
      ['ls', 'about  works  blog  contact'],
      ['echo', 'designing a site that feels alive'],
      ['git', 'status: building / branch: develop'],
      ['cat', 'posts/first-log.md'],
    ];

    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    const run = async () => {
      const root = document.querySelector('[data-terminal]');
      if (!root) return;

      const log = root.querySelector('[data-terminal-log]');
      if (!log) return;

      log.innerHTML = '<p class="terminal-row"><span class="cmd">&gt;</span><span class="out">booting session...</span></p>';

      const scrollToBottom = () => {
        log.scrollTop = log.scrollHeight;
      };

      scrollToBottom();
      await wait(350);

      log.innerHTML = '<p class="terminal-row"><span class="cmd">whoami</span><span class="out">developer focused on blog-driven portfolios</span></p>';
      scrollToBottom();
      await wait(500);

      for (const [cmd, out] of lines.slice(1)) {
        const row = document.createElement('p');
        row.className = 'terminal-row';

        const cmdNode = document.createElement('span');
        cmdNode.className = 'cmd';

        const outNode = document.createElement('span');
        outNode.className = 'out';

        row.append(cmdNode, outNode);
        log.append(row);

        for (const char of cmd) {
          cmdNode.textContent += char;
          await wait(28);
          scrollToBottom();
        }

        await wait(160);

        for (const char of out) {
          outNode.textContent += char;
          await wait(16);
          scrollToBottom();
        }

        await wait(220);
      }
    };

    run();
  </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #050816;
    --panel: rgba(10, 18, 36, 0.82);
    --line: rgba(93, 243, 255, 0.18);
    --text: #d7f6ff;
    --muted: #86a9b6;
    --accent: #5df3ff;
    --accent-2: #7cffb2;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(93, 243, 255, 0.12), transparent 36%),
      linear-gradient(180deg, #050816 0%, #02040b 100%);
    color: var(--text);
    font-family: Inter, system-ui, sans-serif;
    letter-spacing: 0.01em;
    word-spacing: 0.02em;
    text-rendering: geometricPrecision;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(93, 243, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(93, 243, 255, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(124, 255, 178, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 255, 178, 0.03) 1px, transparent 1px);
    background-size: 32px 32px, 32px 32px, 160px 160px, 160px 160px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent 90%);
  }

  .shell {
    width: min(1100px, calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 64px;
    display: grid;
    gap: 20px;
  }

  .panel {
    border: 1px solid rgba(93, 243, 255, 0.18);
    background:
      linear-gradient(180deg, rgba(10, 18, 36, 0.92), rgba(3, 10, 24, 0.82)),
      var(--panel);
    backdrop-filter: blur(16px);
    border-radius: 20px;
    padding: 24px;
    box-shadow:
      0 0 0 1px rgba(93, 243, 255, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 24px 80px rgba(0, 0, 0, 0.35);
  }

  .hero h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.1;
  }

  .hero h1 {
    max-width: 14ch;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    margin-top: 8px;
    position: relative;
  }

  .hero h1::after {
    content: '▍';
    display: inline-block;
    margin-left: 0.18em;
    color: var(--accent-2);
    animation: blink 1s steps(1, end) infinite;
  }

  .lead,
  .panel p,
  .muted,
  .list span,
  .list small,
  .post-card p {
    color: var(--muted);
  }

  .eyebrow,
  .section-label,
  .post-meta,
  .stats span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--accent);
  }

  .lead {
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .terminal {
    margin-top: 20px;
    border: 1px solid rgba(93, 243, 255, 0.22);
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(3, 10, 24, 0.92), rgba(2, 6, 16, 0.98));
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(93, 243, 255, 0.16);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .terminal-bar span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(93, 243, 255, 0.28);
    box-shadow: 0 0 10px rgba(93, 243, 255, 0.22);
  }

  .terminal-bar small {
    margin-left: auto;
    position: relative;
    padding-right: 10px;
  }

  .terminal-bar small::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 14px;
    transform: translateY(-50%);
    background: var(--accent);
    animation: blink 1s steps(1, end) infinite;
  }

  .terminal-lines {
    padding: 14px;
    max-height: 200px;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  .terminal-lines p {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    line-height: 1.9;
    white-space: nowrap;
  }

  .terminal-row + .terminal-row {
    margin-top: 6px;
  }

  .cmd,
  .out {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
  }

  .cmd {
    color: var(--accent);
  }

  .out {
    color: var(--muted);
  }

  .stats {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .stats div,
  .post-card,
  .list li {
    border: 1px solid rgba(93, 243, 255, 0.14);
    background: linear-gradient(180deg, rgba(3, 10, 24, 0.62), rgba(3, 10, 24, 0.42));
    border-radius: 16px;
    padding: 16px;
  }

  .stats strong,
  .list strong,
  .post-card h3 {
    display: block;
    margin-top: 8px;
    color: var(--text);
  }

  .stats strong,
  .list span,
  .list small,
  .post-card p,
  .footer-panel p {
    line-height: 1.85;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .posts {
    display: grid;
    gap: 14px;
  }

  .post-meta,
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .blog h2,
  .footer-panel h2 {
    margin-top: 8px;
  }

  .section-head {
    margin-bottom: 16px;
  }

  .footer-panel {
    display: grid;
    gap: 8px;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 760px) {
    .grid,
    .stats {
      grid-template-columns: 1fr;
    }

    .section-head,
    .post-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .terminal-lines p {
      white-space: normal;
      grid-template-columns: 1fr;
    }

    .terminal-lines p {
      white-space: normal;
      grid-template-columns: 1fr;
    }

    .shell {
      width: min(100% - 20px, 1100px);
      padding-top: 20px;
    }
  }
</style>
